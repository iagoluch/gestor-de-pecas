# Variáveis usadas pelo compose.yaml local. Nunca coloque senha real neste exemplo versionado.
POSTGRES_DB=gestor_pecas_test
POSTGRES_USER=gestor_app
POSTGRES_PASSWORD=troque_a_senha
TEST_DATABASE_URL=postgresql://gestor_app:troque_a_senha@127.0.0.1:15432/gestor_pecas_test

# Pool síncrono conservador para o backend Web.
PGPOOL_MIN_SIZE=1
PGPOOL_MAX_SIZE=4
PGPOOL_TIMEOUT=5
PGCONNECT_TIMEOUT=5
# Fuso da sessão PostgreSQL. Precisa acompanhar o fuso em que a aplicação
# grava os timestamps produtivos, senão durações calculadas em SQL ficam
# deslocadas pelo offset do servidor.
GESTOR_DB_TIMEZONE=America/Sao_Paulo
GESTOR_TEST_ALLOWED_HOSTS=127.0.0.1

# Inicialização/migrations: evita espera indefinida por locks no PostgreSQL.
GESTOR_MIGRATION_LOCK_TIMEOUT_MS=5000
GESTOR_MIGRATION_STATEMENT_TIMEOUT_MS=60000

# Entrada de planejamento TOTVS ProductionOrder V1. Fechada por padrão.
# WhoIs e ProductionOrder respondem com TOTVSMessage/ResponseMessage
# (ProcessingInformation/Status=OK), que é o contrato lido por PCPWebsPPI.
# O ACK textual abaixo permanece apenas como fallback quando o MessageInformation
# da mensagem recebida não pôde ser lido.
# Revalidar no ambiente REAL antes de habilitar em produção.
GESTOR_TOTVS_ENABLED=false
GESTOR_TOTVS_SOAP_ENABLED=false
GESTOR_TOTVS_SOAP_SUCCESS_RESULT=OK
GESTOR_TOTVS_MAX_XML_BYTES=1048576
GESTOR_TOTVS_RESOURCE_MAP_JSON={}
GESTOR_TOTVS_SECTOR_MAP_JSON={}
# Identidade do Gestor nas respostas ao TOTVS (WhoIs e ProductionOrder). O
# PCPWebsPPI não valida estes campos; eles existem para o Gestor não se passar
# por outro produto.
GESTOR_TOTVS_IDENTITY_SOURCE_APPLICATION=GESTOR_PECAS
GESTOR_TOTVS_IDENTITY_PRODUCT_NAME=GESTOR_PECAS
GESTOR_TOTVS_IDENTITY_PRODUCT_VERSION=1.0
GESTOR_TOTVS_IDENTITY_CONTEXT_NAME=GESTOR_PECAS

# Outbound manual/controlado para o WSPCP do TOTVS TESTE. Permanece vazio e
# desabilitado por padrão. O script também exige banco gestor_pecas_test,
# hostname exato e confirmação literal TOTVS_TESTE antes de transmitir.
GESTOR_TOTVS_OUTBOUND_ENDPOINT=https://gtsdo143182.protheus.cloudtotvs.com.br:1465/ws/WSPCP.apw
GESTOR_TOTVS_OUTBOUND_EXPECTED_HOST=gtsdo143182.protheus.cloudtotvs.com.br
GESTOR_TOTVS_OUTBOUND_TIMEOUT_SECONDS=30
GESTOR_TOTVS_OUTBOUND_AUTH_MODE=basic
GESTOR_TOTVS_OUTBOUND_USERNAME=
GESTOR_TOTVS_OUTBOUND_PASSWORD=
GESTOR_TOTVS_OUTBOUND_SOAP_ACTION=http://webservices.totvs.com.br/RECEIVEMESSAGE
GESTOR_TOTVS_OUTBOUND_SERVICE_NAMESPACE=http://webservices.totvs.com.br/
GESTOR_TOTVS_OUTBOUND_VERIFY_TLS=true

# Outbox transacional (Etapa 6). A fila é gravada na mesma transação do
# apontamento; o operador nunca espera o WSPCP. Ambas as chaves nascem
# desligadas: o mesmo código roda em TESTE e no piloto REAL, mudando só o .env.
# Nenhum nome de banco participa da lógica.
GESTOR_TOTVS_OUTBOX_ENABLED=false
GESTOR_TOTVS_OUTBOX_WORKER_ENABLED=false
GESTOR_TOTVS_OUTBOX_WORKER_INTERVAL_SECONDS=15
GESTOR_TOTVS_OUTBOX_BATCH_SIZE=10
GESTOR_TOTVS_OUTBOX_LEASE_SECONDS=120
GESTOR_TOTVS_OUTBOX_MAX_ATTEMPTS=12

# Aviso ao supervisor quando um item da outbox para em ERROR (ex.: OP já
# totalizada no TOTVS) — pendência 2 do piloto (14/09/2026). Reaproveita o bot
# de TELEGRAM_BOT_TOKEN abaixo; sem chat_id aqui, nenhum aviso é enviado.
GESTOR_TOTVS_OUTBOX_TELEGRAM_CHAT_ID=

# Botão de chamada (operador e tela de gestão). Reaproveita TELEGRAM_BOT_TOKEN;
# sem este chat, a chamada fica registrada no banco mas o aviso não é enviado.
GESTOR_CHAMADA_TELEGRAM_CHAT_ID=

# Bot de fábrica: Fábrica recebe o consolidado geral; cada chave setorial
# recebe somente o resumo do painel canônico correspondente. Alertas usa
# GESTOR_TOTVS_OUTBOX_TELEGRAM_CHAT_ID e não recebe digest.
GESTOR_TELEGRAM_BOT_POLLING_ENABLED=false
GESTOR_TELEGRAM_DIGEST_ENABLED=false
GESTOR_TELEGRAM_FACTORY_CHAT_ID=
GESTOR_TELEGRAM_SECTOR_CHAT_IDS={}
GESTOR_TELEGRAM_DIGEST_DAILY_TIME=18:00
GESTOR_TELEGRAM_DIGEST_TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Busca de OP sob demanda (Etapa 6.1)
# O operador digita uma OP que não existe no Gestor e ela é buscada no TOTVS
# pelo MESMO pipeline inbound do push. Sem endpoint não existe busca remota: o
# Gestor responde apenas o lookup local e informa indisponibilidade.
#
# O Protheus deste ambiente ainda NÃO publica a rotina de solicitação. Ver a
# especificação em docs/INTEGRACAO_TOTVS_OP_SOB_DEMANDA_ETAPA61.md, seção 3.
# ---------------------------------------------------------------------------
GESTOR_TOTVS_OP_PULL_ENDPOINT=
# inline = a rotina devolve o ProductionOrder; push = ela só pede o envio e a
# mensagem chega pelo /PcfIntegService normal.
GESTOR_TOTVS_OP_PULL_MODE=inline
GESTOR_TOTVS_OP_PULL_TIMEOUT_SECONDS=20
GESTOR_TOTVS_OP_PULL_WAIT_SECONDS=25
GESTOR_TOTVS_OP_PULL_POLL_INTERVAL_MS=500
GESTOR_TOTVS_OP_PULL_NEGATIVE_TTL_SECONDS=60
GESTOR_TOTVS_OP_PULL_COMPANY_ID=01
GESTOR_TOTVS_OP_PULL_BRANCH_ID=010004
GESTOR_TOTVS_OP_PULL_USERNAME=
GESTOR_TOTVS_OP_PULL_PASSWORD=
GESTOR_TOTVS_OP_PULL_VERIFY_TLS=1

# ---------------------------------------------------------------------------
# Consulta de MODELO do produto sob demanda (B1_ZMODELO), rotina GPB1MODL.
#
# Espelha o pull de OP acima: sem endpoint configurado, o gateway é None e
# catalogo_pcp_ops.produto_modelo continua nulo (tela mostra "Modelo não
# identificado."). Dispara best-effort logo após uma OP nascer via pull de OP
# sob demanda — nunca bloqueia nem falha o provisionamento da OP.
# Ver docs/INTEGRACAO_TOTVS_MODELO_PRODUTO_SOB_DEMANDA.md.
# ---------------------------------------------------------------------------
GESTOR_TOTVS_MODEL_PULL_ENDPOINT=
GESTOR_TOTVS_MODEL_PULL_TIMEOUT_SECONDS=20
GESTOR_TOTVS_MODEL_PULL_VERIFY_TLS=1
# Se vazios, reaproveita GESTOR_TOTVS_OP_PULL_USERNAME/PASSWORD.
GESTOR_TOTVS_MODEL_PULL_USERNAME=
GESTOR_TOTVS_MODEL_PULL_PASSWORD=
# Apontamento de quantidade zero no início da operação. Homologado na Etapa 5
# (muda a legenda do MATA650 de "Em aberto" para "Iniciada"), mas gera um
# movimento SH6 por início; por isso é opt-in.
GESTOR_TOTVS_OUTBOX_ZERO_START_ENABLED=false
GESTOR_TOTVS_OUTBOX_TERMINAL_ENABLED=true

# Cadastros TOTVS que o Gestor não pode inferir. Sem eles, um refugo ou uma
# parada entra na outbox como ERROR bloqueado — visível e reprocessável — em
# vez de ser convertido por semelhança de nome ou descartado.
# WasteCode confirmados no TESTE: FH, FM, FP, NC, RB, RP.
GESTOR_TOTVS_OUTBOUND_WASTE_CODE_MAP_JSON={}
GESTOR_TOTVS_OUTBOUND_DEFAULT_WASTE_CODE=
# StopReasonCode: SX5 grupo 44. Confirmados no TESTE: 0009 a 0028 e FE.
GESTOR_TOTVS_OUTBOUND_STOP_REASON_MAP_JSON={}
GESTOR_TOTVS_OUTBOUND_DEFAULT_STOP_REASON_CODE=

# API/Web. Em produção, use um segredo aleatório com ao menos 32 bytes.
GESTOR_WEB_ENV=development
GESTOR_WEB_SESSION_SECRET=
GESTOR_WEB_SESSION_TTL_SECONDS=28800
GESTOR_WEB_COOKIE_SECURE=false
GESTOR_WEB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GESTOR_WEB_ALLOWED_HOSTS=127.0.0.1,localhost,gestor-peca
GESTOR_WEB_STREAM_INTERVAL_SECONDS=15
GESTOR_WEB_DATABASE_RETRY_SECONDS=5
# Alias preferencial para DNS/reverse proxy interno; não é exigido em desenvolvimento.
GESTOR_WEB_PUBLIC_HOST=gestor-peca
GESTOR_WEB_SERVE_STATIC=true

# Dev Observatory — ferramenta de observabilidade do desenvolvedor, em
# /dev-observatory. Login PRÓPRIO, isolado do login principal do Gestor de
# Peças de propósito: não usa a tabela `usuarios`. Sem usuário/senha aqui, a
# ferramenta fica inacessível (login sempre recusado), mas continua capturando
# eventos normalmente. Defina os três valores para poder entrar.
GESTOR_DEV_OBSERVATORY_ENABLED=true
GESTOR_DEVOBS_LOGIN_USERNAME=
GESTOR_DEVOBS_LOGIN_PASSWORD=
# Em produção, gere um segredo aleatório com ao menos 32 bytes (igual ao
# GESTOR_WEB_SESSION_SECRET acima) — nunca reaproveite o mesmo valor dos dois.
GESTOR_DEVOBS_SESSION_SECRET=
# Somente leitura, comprovada contra o servidor (backend/observability/readonly_db.py).
# Vazio desliga a observação do ambiente REAL (o TESTE continua funcionando).
GESTOR_DEVOBS_REAL_DATABASE_URL=

# IA Industrial gerencial. A chave real permanece somente no .env local.
GROQ_API_KEY=
GESTOR_AI_ENABLED=false
GESTOR_AI_MODEL=openai/gpt-oss-120b
GESTOR_AI_REASONING_EFFORT=medium
GESTOR_AI_TEMPERATURE=0.2
GESTOR_AI_MAX_COMPLETION_TOKENS=640
GESTOR_AI_REQUEST_TOKEN_BUDGET=6000
GESTOR_AI_TOOL_RESULT_MAX_CHARS=10000
GESTOR_AI_REAL_TEST=false
GESTOR_AI_MAX_TOOL_ROUNDS=6
GESTOR_AI_MAX_HISTORY_MESSAGES=20
GESTOR_AI_TIMEOUT_SECONDS=60

# Artifacts XLSX e automação. Horários pertencem a cada agendamento no banco.
GESTOR_REPORT_ARTIFACT_DIR=
GESTOR_REPORT_EXPIRATION_HOURS=168
GESTOR_REPORT_MAX_BYTES=52428800
GESTOR_REPORT_AUTOMATION_ENABLED=false
GESTOR_REPORT_SCHEDULER_INTERVAL_SECONDS=60

# Telegram permanece opt-in; o token nunca é enviado ao frontend.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
GESTOR_TELEGRAM_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# SigmaNEST — fonte oficial do planejamento de Corte (Etapa 3.1)
# Acesso SOMENTE LEITURA. Nunca conceder INSERT/UPDATE/DELETE/DDL ao Gestor.
# Preencha o DSN completo OU as variáveis separadas.
# ---------------------------------------------------------------------------
# SIGMANEST_ODBC_DSN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=192.168.0.218,55035;DATABASE=SNDBase2026;UID=ti_consulta;PWD=troque-aqui;TrustServerCertificate=yes
SIGMANEST_SERVER=192.168.0.218,55035
SIGMANEST_DATABASE=SNDBase2026
SIGMANEST_USER=ti_consulta
SIGMANEST_PASSWORD=
SIGMANEST_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Sincronizacao automatica do planejamento de Corte (Wave 2).
# Liga sozinha quando o SigmaNEST acima esta configurado; use =false para
# desligar. O ciclo reaproveita o mesmo SigmaNestSyncService do script manual,
# le somente do SigmaNEST e e idempotente no PostgreSQL do Gestor.
# GESTOR_SIGMANEST_SYNC_ENABLED=true
GESTOR_SIGMANEST_SYNC_INTERVAL_SECONDS=120
GESTOR_SIGMANEST_SYNC_OVERLAP_DAYS=7
