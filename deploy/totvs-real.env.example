# Conexão com o Protheus REAL. NÃO é a do teste (gtsdo143182 / CSED4J_DEV).
# Copie para deploy/.env.totvs-real (ignorado pelo git), troque todos os TROCAR e rode
# python deploy/montar_pacote.py. O pacote só sai se não sobrar nenhum TROCAR.

# Envio de apontamentos ao Protheus (WSPCP).
GESTOR_TOTVS_OUTBOUND_ENDPOINT=https://TROCAR:PORTA/ws/WSPCP.apw
GESTOR_TOTVS_OUTBOUND_EXPECTED_HOST=TROCAR
GESTOR_TOTVS_OUTBOUND_USERNAME=TROCAR
GESTOR_TOTVS_OUTBOUND_PASSWORD=TROCAR

# Busca de OP e de modelo no Protheus (REST).
GESTOR_TOTVS_OP_PULL_ENDPOINT=https://TROCAR:PORTA/rest/GESTORPECASPO/gestorpecas/v1/production-order
GESTOR_TOTVS_OP_PULL_USERNAME=TROCAR
GESTOR_TOTVS_OP_PULL_PASSWORD=TROCAR
GESTOR_TOTVS_OP_PULL_COMPANY_ID=01
GESTOR_TOTVS_OP_PULL_BRANCH_ID=010001,010002,010004
GESTOR_TOTVS_MODEL_PULL_ENDPOINT=https://TROCAR:PORTA/rest/GESTORPECASB1/gestorpecas/v1/product-model
