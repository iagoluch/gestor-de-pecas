{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CLAUDE.md"
  ],
  "permission": {
    "external_directory": {
      "*": "deny"
    },
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "*.ssh*": "deny",
      "*.claude*": "deny",
      "git push*": "deny",
      "git commit*": "deny"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
